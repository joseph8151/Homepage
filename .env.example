# ── 사이트 ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Supabase (상담 저장 · 관리자 · 콘텐츠 관리) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마십시오.
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자 (쉼표로 여러 명 가능, Supabase Auth에 같은 이메일 계정이 있어야 함) ──
ADMIN_EMAILS=

# ── 신규 상담 알림 (선택) ────────────────────────────
# 이메일(Resend): 세 값이 모두 있어야 동작
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# 웹훅(Slack/Discord 등): https 주소
NOTIFY_WEBHOOK_URL=

# ── 검색엔진 소유 확인 ───────────────────────────────
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
